{
  "name": "ai-mis-ops-center",
  "version": "0.6.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/run-bash.mjs scripts/install-ci.sh",
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "node scripts/run-bash.mjs scripts/build-verified.sh",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "test:source": "node --test tests/*source.test.mjs",
    "validate:artifact": "node scripts/run-bash.mjs scripts/validate-artifact.sh",
    "lint": "node scripts/run-bash.mjs scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern drizzle-recovered --ignore-pattern worker-configuration.d.ts",
    "db:generate": "node scripts/run-bash.mjs scripts/sites-env.sh -- drizzle-kit generate",
    "db:migrate:remote": "wrangler d1 migrations apply site-creator-d1 --remote",
    "db:migrate:local": "wrangler d1 migrations apply site-creator-d1 --local",
    "clean:dev": "node scripts/clean-dev.mjs",
    "check": "npm run test:source && npm run lint && npm run build"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-rsc": "0.5.26",
    "better-sqlite3": "^13.0.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "^4.118.0"
  },
  "type": "module",
  "displayName": "AI MIS OPS Center"
}
