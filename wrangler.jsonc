{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-mis-ops-center",
  "main": "./dist/server/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "site-creator-d1",
      "database_id": "62274d37-7a11-427e-83bd-0dd7e3b66ba5"
    }
  ],
  "observability": {
    "enabled": true
  }
}
